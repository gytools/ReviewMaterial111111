{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "review-materials",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "d1_databases": [{"binding": "DB", "database_name": "review-materials-db", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations"}]
}
